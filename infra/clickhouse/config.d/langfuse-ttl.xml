<?xml version="1.0"?>
<!--
  ClickHouse disk protection for a single-node Tier 1 deployment.

  This must be mounted BEFORE the first byte is ingested. On one box, ClickHouse's
  own system tables will consume the NVMe at default settings, and retrofitting
  these TTLs means an outage.

  This is distinct from Langfuse's 90-day TRACE retention. That governs customer
  data; this governs ClickHouse's internal logging — a common and entirely
  avoidable cause of disk exhaustion on single-node deployments.

  ══════════════════════════════════════════════════════════════════════════════
  IMPLEMENTATION NOTE — verified empirically against ClickHouse 25.12.

  ClickHouse rejects mixing <engine> with <partition_by>/<ttl> on a system table,
  in BOTH directions, and the server then refuses to start (exit 36):

      "If 'engine' is specified for system table, PARTITION BY parameters should
       be specified directly inside 'engine'..."
      "If 'engine' is specified for system table, TTL parameters should be
       specified directly inside 'engine' and 'ttl' setting doesn't make sense."

  What the stock config.xml ships decides which form is legal here:

      query_log, trace_log, part_log   → <partition_by>, no engine  → bare <ttl>
      metric_log, asynchronous_metric_log → neither                 → bare <ttl>
      opentelemetry_span_log           → <engine>                   → replace the
                                          whole element, TTL inside the engine

  Do not "tidy" these into a single consistent form. They are inconsistent
  because the upstream defaults are inconsistent.
  ══════════════════════════════════════════════════════════════════════════════
-->
<clickhouse>
    <!-- The query profiler samples stacks continuously. High overhead, and it is
         the single largest contributor to trace_log growth. Off. -->
    <profiles>
        <default>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </default>
    </profiles>

    <trace_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </trace_log>

    <!-- Stated explicitly even though 30 days is also the upstream default, so a
         future upstream change cannot silently lengthen our retention. -->
    <query_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>

    <part_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </part_log>

    <!-- These two grow steadily and have no diagnostic value beyond a short
         window. metric_log in particular writes a row per second. -->
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>

    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>

    <!-- replace="replace" swaps the entire stock element rather than merging into
         it, which is the only way to attach a TTL to a table whose upstream
         definition already carries an <engine>. -->
    <opentelemetry_span_log replace="replace">
        <engine>
            ENGINE = MergeTree
            PARTITION BY toYYYYMM(finish_date)
            ORDER BY (finish_date, finish_time_us, trace_id)
            TTL finish_date + INTERVAL 7 DAY DELETE
        </engine>
        <database>system</database>
        <table>opentelemetry_span_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <reserved_size_rows>8192</reserved_size_rows>
        <buffer_size_rows_flush_threshold>524288</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </opentelemetry_span_log>
</clickhouse>
