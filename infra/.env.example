# Langfuse Tier 1 — environment template.
#
# Copy to infra/.env via ./scripts/generate-secrets.sh, which fills every CHANGEME
# with a fresh 256-bit random value. Never commit infra/.env.
#
# Target: Langfuse v4. Variables marked REQUIRED are mandatory per
# https://langfuse.com/self-hosting/configuration — the app will not start without them.

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=langfuse
# REQUIRED
DATABASE_URL=postgresql://langfuse:CHANGEME@postgres:5432/langfuse

# ─── ClickHouse ─────────────────────────────────────────────────────────────
# REQUIRED (all four)
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
# Defaults to true upstream. MUST be false for a single-node deployment.
# Langfuse does not support multi-shard clusters — shard count stays 1.
CLICKHOUSE_CLUSTER_ENABLED=false

# ─── Redis / Valkey ─────────────────────────────────────────────────────────
# REQUIRED
REDIS_AUTH=CHANGEME
REDIS_CONNECTION_STRING=redis://default:CHANGEME@redis:6379

# Valkey's own memory ceiling. MUST stay BELOW the container memory limit in
# compose.yaml (8G), and the two must be changed together.
#
# Why both exist: Valkey holds the ingestion queue under --maxmemory-policy
# noeviction. With only a container limit, Valkey grows until the kernel
# OOM-kills it and the ENTIRE queue is lost silently. With maxmemory set lower,
# Valkey refuses writes first and producers get explicit errors. Loud and
# bounded beats silent and total when the payload is a queue.
#
# 6gb against the 1GB-per-100k-events/min rule (CLAUDE.md §8.5) covers roughly
# 600k events/minute — far above the aspirational ceiling.
REDIS_MAXMEMORY=6gb

# ─── Blob storage (MinIO at Tier 1) ─────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# Event upload — REQUIRED. Raw ingestion events land here before the worker
# processes them into ClickHouse.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=eu-central-1
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

# Media upload — REQUIRED in v4. Omitting this bucket prevents startup.
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=eu-central-1
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# ─── Langfuse app ───────────────────────────────────────────────────────────
# REQUIRED. Generate each with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
# Must be exactly 256 bits (64 hex characters).
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_URL=https://langfuse.example.com

# Anonymous usage telemetry to Langfuse. Disabled: this is a private EU platform.
TELEMETRY_ENABLED=false

# ─── SSO: Microsoft Entra ID ────────────────────────────────────────────────
# sportnavi.de runs on Microsoft 365 (MX → *.mail.protection.outlook.com), so
# Entra ID is the company identity provider. This is what replaces ADMIN_ALLOWLIST:
# access becomes "an authenticated tenant identity" instead of "whoever currently
# holds this IP address".
#
# ⚠️ The domain restriction is NOT set here. It is the app registration's
# "supported account types" = SINGLE TENANT. Set that wrong and every Microsoft
# account on the internet can sign in, while these variables still look correct.
#
# Leave blank to keep SSO disabled — Langfuse then falls back to password login.
# Setup: docs/superpowers/plans/2026-08-11-admin-access-sso-migration.md
AUTH_AZURE_AD_CLIENT_ID=
# The client secret VALUE, not the Secret ID. Note its expiry date: an expired
# secret locks everyone out of the UI with no prior warning.
AUTH_AZURE_AD_CLIENT_SECRET=
AUTH_AZURE_AD_TENANT_ID=

# Set true when switching an existing deployment from password login to SSO:
# accounts created before SSO cannot be signed into via Entra without it, and
# fail with OAuthAccountNotLinked. Requires a single-tenant app registration —
# see the security note in compose.yaml before enabling.
AUTH_AZURE_AD_ALLOW_ACCOUNT_LINKING=false

# Makes SSO the only way in. Enable ONLY after confirming an Entra identity holds
# OWNER on the org — otherwise the platform has no reachable administrator.
#
# This is the END STATE and the primary registration control (audit F-02): with
# it true, the only credential is Entra, so the single-tenant app registration
# decides who can even hold an account. The live server already enforces true —
# verified 2026-08-12 by a credentials POST returning "Sign in with email and
# password is disabled for this instance."
#
# It ships false in this TEMPLATE on purpose: a fresh deployment has no Entra
# identity yet, and a first boot with this true and no working SSO is a platform
# with no reachable administrator. Flip it as the last step of the cut-over,
# never as part of the initial provision. Order is in docs/GRAFANA-SSO.md §9 and
# the ordering rule is the same one that applies to GRAFANA_DISABLE_LOGIN_FORM.
AUTH_DISABLE_USERNAME_PASSWORD=false

# Who may create an ORGANISATION. Comma-separated email addresses (audit F-02).
#
# ⚠️ EMPTY MEANS "ANY AUTHENTICATED USER", not "nobody". This is the backstop
# behind AUTH_DISABLE_USERNAME_PASSWORD: even if a principal does obtain an
# account, it cannot mint an org — and therefore cannot allocate ClickHouse and
# NVMe capacity on the box whose primary documented risk is disk exhaustion
# (CLAUDE.md §10.1).
#
# Deliberately NOT AUTH_DISABLE_SIGNUP: that flag also blocks invited colleagues
# who do not have an account yet, which breaks onboarding. Restrict the
# privilege, not the door.
#
# Set this to the real admin addresses before the instance is reachable.
LANGFUSE_ALLOWED_ORGANIZATION_CREATORS=platform@example.com

# ─── Headless initialization ────────────────────────────────────────────────
# Provisions the org and admin user at first startup so no resource is created
# by hand. Per-project keys are added later by ./scripts/provision-project.sh.
#
# ⚠️ THESE MUST BE BLANKED once a real SSO owner exists. compose.yaml re-creates
# the org and seed user on EVERY web start when they are set, so the
# password-login seed account cannot be deleted through the UI — it returns on
# the next restart, after password login has supposedly been disabled.
#
# Order, and it is not reversible if you get it wrong:
#   1. sign in over Entra and confirm that identity holds OWNER on the org
#   2. blank LANGFUSE_INIT_USER_EMAIL / _NAME / _PASSWORD (leave the ORG lines)
#   3. set AUTH_DISABLE_USERNAME_PASSWORD=true
#   4. recreate web, then verify the credentials POST is refused
LANGFUSE_INIT_ORG_ID=org-main
LANGFUSE_INIT_ORG_NAME=Main
LANGFUSE_INIT_USER_EMAIL=platform@example.com
LANGFUSE_INIT_USER_NAME=Platform
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# ─── Ingest tuning (raise only on observed S3 throttling) ───────────────────
LANGFUSE_S3_CONCURRENT_WRITES=50

# ─── Ingress ────────────────────────────────────────────────────────────────
LANGFUSE_DOMAIN=langfuse.example.com
ACME_EMAIL=platform@example.com
# ⚠️ ADMIN_ALLOWLIST HAS BEEN REMOVED — do not add it back.
#
# There is no IP-based trust anywhere in this deployment. Both the Langfuse UI
# and Grafana are gated by Microsoft Entra ID SSO (single-tenant) instead.
#
# It was removed for three reasons, all verified rather than theorised:
#   1. It did not enforce. On 2026-08-12 Grafana's /api/health answered an
#      arbitrary internet client while every config file and the test suite
#      said the surface was gated.
#   2. The operator's entry was a DYNAMIC RESIDENTIAL IP. Rotation locks you
#      out and hands allowlisted reach to the next ISP customer.
#   3. It also trusted the box's own public IP and the whole Docker /12 —
#      i.e. every container on the host, and any SSRF primitive reachable
#      from it.
#
# If you find yourself wanting it back, the question to answer first is which
# identity should have access — not which address.

# ─── Backups (scripts/backup.sh, scripts/restore-test.sh) ───────────────────
# Audit finding F-04. Before this existed there were no backups at all —
# Postgres holds every project API key, every org and every user, and losing it
# costs the platform's identity, not just its history (CLAUDE.md §13).

# Encrypts every artifact. Generated by ./scripts/generate-secrets.sh.
#
# ⚠️ UNLIKE EVERY OTHER SECRET IN THIS FILE, THIS ONE CANNOT SIMPLY BE ROTATED.
# Change it without keeping the old value and every existing backup becomes
# permanently undecryptable. And it lives on the machine it protects: if the box
# is lost, the key is lost, and the off-host copies are unreadable — a backup
# you cannot decrypt is not a backup.
#
# Put it in the team password manager and record where in docs/OPERATIONS.md.
BACKUP_ENCRYPTION_KEY=CHANGEME

# Where backups are staged locally before being shipped.
BACKUP_DIR=/var/backups/langfuse

# rsync-over-SSH destination — Hetzner Storage Box is the intended target (EU,
# same provider, separate machine). Example:
#   BACKUP_REMOTE=u123456@u123456.your-storagebox.de:langfuse/
#
# ⚠️ backup.sh REFUSES TO RUN with this unset unless --local-only is passed. A
# backup on the same NVMe as the database protects against a dropped table and
# against nothing that destroys a box.
#
# Remote retention is deliberately the storage target's job, not this script's:
# pruning the remote from the machine being backed up means a compromise of that
# machine can erase its own backups.
BACKUP_REMOTE=

# Local staging retention. The remote keeps its own, longer, history.
BACKUP_RETENTION_DAYS=14

# Where backup.sh and restore-test.sh write Prometheus textfile metrics, so a
# FAILED OR ABSENT backup pages instead of being merely logged. Must match the
# node-exporter bind mount in compose.monitoring.yaml.
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile

# ─── Monitoring (compose.monitoring.yaml) ───────────────────────────────────
# Only used when the monitoring stack is merged in:
#   docker compose -f compose.yaml -f compose.monitoring.yaml up -d
#
# The platform starts fine without any of these; they are all defaulted.

# Grafana's hostname. REQUIRES its own DNS A record pointing at this box —
# without one, ACME cannot complete the challenge and Caddy retries forever.
#
# This hostname is PUBLIC and gated by Entra ID SSO, exactly like the Langfuse
# domain. There is no allowlist in front of it.
#
# Left blank, the Caddyfile falls back to grafana.localhost, which Caddy serves
# with an internal self-signed certificate and never sends to ACME.
GRAFANA_DOMAIN=grafana.langfuse.example.com

# Grafana's local admin account. Generated by ./scripts/generate-secrets.sh.
#
# With GRAFANA_DISABLE_LOGIN_FORM=true (the end state) this account cannot be
# used from anywhere — that flag removes the login form on EVERY interface, not
# just the public one, so an SSH tunnel does not reach it either.
#
# It is still the break-glass path, but the path runs through the server:
#   1. ssh to the box
#   2. set GRAFANA_DISABLE_LOGIN_FORM=false in infra/.env
#   3. docker compose -f compose.yaml -f compose.monitoring.yaml \
#        up -d --force-recreate grafana
#   4. log in as this account
# ~60 seconds. Needed when the Entra client secret expires — which it will,
# silently, locking every human out of the monitoring UI at once.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME

# ─── Grafana SSO (Microsoft Entra ID) ───────────────────────────────────────
# REQUIRED in the current design — this is what replaced ADMIN_ALLOWLIST. Left
# unset, Grafana falls back to the local admin account and the dashboards have
# only a password in front of them. Full setup and cut-over: docs/GRAFANA-SSO.md.
#
# Same tenant as Langfuse (AUTH_AZURE_AD_TENANT_ID, above). A dedicated app
# registration is strongly preferred: redirect URIs and app roles are per-
# application, and one secret whose rotation or leak hits the platform and its
# monitoring simultaneously is a bad failure mode.
#
# Redirect URI to register, under platform "Web":
#   https://<GRAFANA_DOMAIN>/login/azuread
#
# On the registration itself:
#   - Supported account types MUST be "this organizational directory only"
#     (AzureADMyOrg). This is half the tenant lock; the other half is
#     GF_AUTH_AZUREAD_ALLOWED_ORGANIZATIONS in compose.monitoring.yaml. Entra
#     has no allowed-domains concept, so BOTH are required.
#   - Add the `email` optional claim to the ID token. Grafana identifies users
#     by email; without it the handshake completes and THEN fails to map a user.
#   - Turn implicit grant OFF. Grafana uses auth code + PKCE and does not need
#     it; implicit returns tokens in the URL fragment.
#   - Grant no Microsoft Graph application ("Role") permissions. Grafana needs
#     `openid email profile` and nothing more, and this secret lives in an
#     internet-facing container.
#
# Verify the registration before enabling — the same script Langfuse uses:
#   EXPECTED_REDIRECT=https://<GRAFANA_DOMAIN>/login/azuread \
#     bash scripts/test-entra-app.sh <manifest.json>
GRAFANA_SSO_ENABLED=false
GRAFANA_AZURE_AD_CLIENT_ID=
GRAFANA_AZURE_AD_CLIENT_SECRET=

# Refuse any identity carrying no Grafana app role, instead of admitting it as a
# Viewer.
#
# ⚠️ MUST STAY false unless app roles actually exist on the registration.
# This deployment deliberately defines NO app roles: tenant membership is the
# access control, and every sportnavi identity signs in as a Viewer via
# Grafana's auto_assign_org_role default. Setting this true with no roles in the
# token refuses EVERYONE, and with the login form disabled that is a total
# lockout recoverable only over SSH.
#
# Add the four roles (Viewer/Editor/Admin/GrafanaAdmin) first if you ever need
# real Grafana admin over SSO — most likely when alerting lands and rules are
# edited in the UI. See docs/GRAFANA-SSO.md §3.
GRAFANA_SSO_ROLE_STRICT=false

# Removes the local login form, leaving Entra as the only way in. The equivalent
# of AUTH_DISABLE_USERNAME_PASSWORD on the Langfuse side.
#
# ⚠️ Last step, never the first. Set this only after an Entra sign-in has really
# succeeded — proven by signing in, not by reading a config or providers
# endpoint (DEPLOYMENT-PITFALLS.md #11). With a misconfigured provider this
# turns a broken login into a total lockout.
GRAFANA_DISABLE_LOGIN_FORM=false

# BullMQ queue keys, scraped by redis_exporter to produce worker queue depth —
# the scaling signal from CLAUDE.md §11.2.
#
# ⚠️ DO NOT GUESS THIS VALUE. Langfuse exposes no Prometheus endpoint, so queue
# depth is read from BullMQ's Redis keys, and BullMQ's prefix is a
# construction-time option that Langfuse does not document. A wrong pattern
# produces no error — the queue panels simply render EMPTY, which is
# indistinguishable from an idle, healthy queue.
#
# Run ./scripts/discover-queue-keys.sh against the live Valkey and paste what it
# prints. The default below is BullMQ's documented default prefix, which is a
# starting point, not a verified fact.
#
# :completed is deliberately excluded — BullMQ retains completed jobs, so that
# key can hold tens of thousands of entries and makes the per-scrape SCAN
# expensive for a number that answers no operational question.
REDIS_QUEUE_KEY_PATTERNS=bull:*:wait,bull:*:active,bull:*:delayed,bull:*:failed,bull:*:paused
