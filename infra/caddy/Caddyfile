{
	email {$ACME_EMAIL}

	# rate_limit is a third-party module (see ./Dockerfile) and therefore has no
	# position in Caddy's standard directive order. Stating it explicitly means the
	# ordering is a property of this file rather than of the module's defaults.
	# Before reverse_proxy: throttled requests must never reach the backend.
	order rate_limit before reverse_proxy

	# Enables Prometheus instrumentation. Required before the `metrics` directive
	# below does anything — the directive alone is silently inert without it.
	#
	# per_host adds a `host` label, separating traffic on the Langfuse domain from
	# traffic on the Grafana domain. Two hosts is negligible cardinality.
	#
	# NOTE what this does NOT give you: Caddy's metrics carry no path label, so
	# this cannot split /api/public/ingestion from the UI within one host. The
	# available labels are host, handler, method and code — `handler` separates
	# proxied requests from the 403s emitted by the deny-by-default block, which
	# is useful (it makes blocked admin attempts visible) but it is not an
	# ingest/UI split.
	#
	# Ingestion THROUGHPUT is therefore read from ClickHouse's inserted-rows
	# counter instead, which measures what actually landed rather than what was
	# accepted at the edge. That distinction matters here: ingestion returns 207
	# on queue, so an edge request count can look perfectly healthy while nothing
	# is being persisted (OPERATIONS.md §1).
	metrics {
		per_host
	}
}

# ── Caddy's own metrics — INTERNAL ONLY ─────────────────────────────────────
# Caddy serves /metrics from its admin API on localhost:2019 by default. Binding
# that admin API to 0.0.0.0 so Prometheus could scrape it would also expose an
# API that can RECONFIGURE THE RUNNING SERVER to every container on the network.
# That is an unacceptable price for a metrics endpoint.
#
# So the metrics handler gets its own plain-HTTP listener instead, and the admin
# API stays on localhost inside the container where it belongs.
#
# :2020 is not in compose.yaml's `ports:` list, so it is reachable only from the
# Docker network — same posture as Postgres, ClickHouse and Valkey. Prometheus
# scrapes it as caddy:2020. Do not publish it: caddy_http_* series expose request
# paths and traffic shape.
:2020 {
	metrics /metrics
}

# Caddy is the ONLY ingress. Nothing else publishes a host port, which is what
# keeps Postgres, ClickHouse, Valkey and MinIO off the public internet.
#
# The Langfuse site block below is public in its entirety. That is deliberate:
# telemetry ingest must be public because Vercel serverless functions have no
# static egress IPs outside Enterprise Secure Compute, and the same is true of
# GitHub-hosted CI runners calling the prompt/dataset/score APIs. Access control
# is therefore per-project API keys for /api/public/*, and Entra ID SSO
# (single-tenant) for the UI and admin routes — never network position.
#
# ADMIN_ALLOWLIST NO LONGER EXISTS anywhere in this file. Grafana was its last
# consumer and now carries Entra ID SSO of its own, so IP-based trust has been
# removed from the deployment entirely rather than kept alive for one surface.
# Do not reintroduce it on either block — see the note on the Grafana block for
# what replaced it and why network position was the wrong control.
{$LANGFUSE_DOMAIN} {
	encode gzip

	log {
		# Per-project ingestion attribution starts here: when one project floods
		# the endpoint, these logs are what identify it within minutes.
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# ── PUBLIC: telemetry ingest ────────────────────────────────────────────
	# Protected by TLS + per-project API keys, never by network position.
	# Enumerated, not prefix-globbed (audit F-17). `/api/public/otel*` also
	# matched `/api/public/otelXYZ` and every future sibling under that prefix,
	# so a new Langfuse endpoint would silently inherit this block's treatment
	# without anyone reviewing it. The OTLP signal paths are a stable, published
	# contract, so they can simply be named.
	#
	# ⚠️ The real path is /api/public/otel/v1/traces. A bare POST to
	# /api/public/otel returns 404 — verified against the live 4.6.0 instance,
	# CLAUDE.md §6.1. The old wildcard hid that; this matcher does not, which is
	# a feature: a canary or exporter pointed at the bare path now fails at the
	# edge instead of looking accepted.
	#
	# FAILURE MODE IF LANGFUSE ADDS A SIGNAL PATH: it falls through to the
	# catch-all handle at the bottom, which also proxies to web:3000. So ingest
	# keeps WORKING — it just loses the 10MB body cap and this rate-limit zone
	# until the path is added here. Degraded protection, never an outage. That
	# is the right way round, and it is why enumerating is safe.
	@ingest path /api/public/otel/v1/traces /api/public/otel/v1/logs /api/public/otel/v1/metrics /api/public/ingestion
	handle @ingest {
		request_body {
			# Bounds accidental telemetry floods and malformed payloads. Deep
			# traces (50-200 observations) batch well under this; raise only on
			# observed 413s, and investigate why the batch is that large first.
			max_size 10MB
		}

		# Size and rate are different controls: max_size bounds ONE request,
		# this bounds the number of them. Deliberately loose — sized to stop a
		# runaway agent loop, not to police normal traffic. Trace volume is still
		# unmeasured (CLAUDE.md §19.1); a limit tuned on guesses would throttle
		# legitimate deep traces. Tighten once real numbers exist.
		#
		# LIMITATION: keyed per source IP, which does NOT give per-project
		# throttling. Vercel functions egress from many rotating IPs, so one
		# project's flood spreads across keys and each stays under the limit.
		# Per-project keying needs {header.Authorization} — that is the API
		# secret, so it must never be combined with `log_key`. Deferred until
		# the volume measurement, and tracked as F-13 in docs/AUDIT-2026-08-12.md.
		rate_limit {
			zone ingest {
				key {remote_host}
				events 1000
				window 1m
			}
		}

		reverse_proxy web:3000
	}

	# ── PUBLIC: health, for off-host external monitoring ────────────────────
	# Langfuse must not be the only system that knows Langfuse is down, so the
	# external monitor must reach these without being on the allowlist.
	#
	# Deliberately NOT rate limited. The off-host monitor polls continuously, and
	# throttling it would make a healthy platform report as down — manufacturing
	# exactly the false signal CLAUDE.md §10.3 warns about.
	@health path /api/public/health /api/public/ready
	handle @health {
		reverse_proxy web:3000
	}

	# ── IDENTITY-GATED: UI, admin, REST API, and every other route ──────────
	# Public by design. Access control is IDENTITY (Entra ID SSO, single-tenant)
	# for the UI, and per-project API KEYS for /api/public/*. It is deliberately
	# NOT network position.
	#
	# ADMIN_ALLOWLIST used to gate this block. It was removed because the
	# operator's entry was a dynamic residential IP: a rotation locked out the
	# UI, the REST API and the MCP endpoint simultaneously, and handed
	# allowlisted admin reach to whichever ISP customer inherited the address.
	# Identity does not rotate out from under you.
	#
	# Justified by Langfuse's own guidance: the langfuse/langfuse container is
	# designed to be exposed publicly, has undergone penetration testing, and is
	# the same image serving Langfuse Cloud.
	#
	# This ALSO unblocks the evaluation layer: agents on Vercel and GitHub-hosted
	# CI runners reach /api/public/v2/prompts, /datasets, /scores and /v2/metrics
	# with keys alone. Neither has static egress IPs, so under the old allowlist
	# neither could — see docs/INTEGRATION-PITFALLS.md #16.
	#
	# There is exactly ONE catch-all handle here, and it proxies. Do not add a
	# trailing `handle { respond 403 }` back: with the catch-all proxying, a
	# leftover deny handler would black-hole the entire UI.
	handle {
		route {
			# Brute-force protection for the auth surface. With the UI reachable
			# without network restriction, /api/auth/* is the exposed surface
			# that matters most, so this is a precondition of the design above
			# rather than a nice-to-have.
			#
			# 30/min per IP: a browser SSO round trip makes several calls
			# (providers, csrf, callback, session), so a tighter limit would
			# break normal logins, while credential stuffing runs orders of
			# magnitude above this.
			rate_limit {
				zone auth {
					match {
						path /api/auth/*
					}
					key {remote_host}
					events 30
					window 1m
				}
			}
			reverse_proxy web:3000
		}
	}
}

# ── IDENTITY-GATED: Grafana ─────────────────────────────────────────────────
# A separate site block, not a subpath on the Langfuse domain. That is deliberate.
#
# A /grafana subpath would have to be matched AHEAD of the Langfuse site's
# handlers, and handle blocks are mutually exclusive and evaluated in order — the
# same hazard documented at length around the /api/auth/* rate limiter above.
# Getting that order wrong exposes an admin surface. A separate site block cannot
# make that mistake, and it also avoids Grafana's serve_from_sub_path, which
# rewrites every asset URL and breaks subtly.
#
# ── WHY THERE IS NO ALLOWLIST HERE ANY MORE ─────────────────────────────────
# This block used to be gated by ADMIN_ALLOWLIST. That gate was removed, and the
# reasoning is the same one already applied to the Langfuse block above:
#
#   1. It did not work. An audit on 2026-08-12 reached Grafana's /api/health from
#      an arbitrary internet client and got {"database":"ok","version":"13.0.6"}
#      back — while this file said the surface was gated and the config test
#      suite passed. Text in a config file is not a control.
#   2. The list contained a DYNAMIC RESIDENTIAL IP. On rotation the operator
#      loses the dashboards, and whichever ISP customer inherits the address
#      gains whatever trust the list confers.
#   3. It also contained the box's own public IP and the whole 172.16.0.0/12
#      Docker range — granting admin trust to every container on the host and to
#      any SSRF primitive reachable from it.
#
# Access control is now IDENTITY: Microsoft Entra ID, single-tenant. The lock is
# two settings that must BOTH hold — the app registration's
# signInAudience=AzureADMyOrg, and GF_AUTH_AZUREAD_ALLOWED_ORGANIZATIONS pinned
# to the tenant id (compose.monitoring.yaml). Entra has no allowed-domains
# concept, so neither alone is sufficient.
#
# Grafana runs SSO-ONLY (GF_AUTH_DISABLE_LOGIN_FORM=true), so there is no
# password form on the internet at all. Break-glass is not a tunnel — that flag
# removes the form on every interface — it is SSH + flipping the variable +
# recreating the container. See docs/GRAFANA-SSO.md §9.
#
# REQUIRES a DNS A record for this name pointing at the box, or ACME cannot issue
# a certificate and Caddy will retry the challenge indefinitely at startup.
#
# Grafana is NOT an ingestion dependency. If this block is wrong, dashboards break
# and telemetry keeps flowing.
# The default matters: an unset GRAFANA_DOMAIN would expand to an empty site
# address and Caddy would refuse to parse the whole file — taking ingest down to
# misconfigure a dashboard. `.localhost` is special-cased by Caddy to an internal
# self-signed certificate, so the fallback never touches ACME and never fails a
# challenge for a name that does not resolve.
{$GRAFANA_DOMAIN:grafana.localhost} {
	encode gzip

	log {
		output file /var/log/caddy/grafana-access.log {
			roll_size 50MiB
			roll_keep 7
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# X-Frame-Options is deliberately NOT set to DENY here, unlike the Langfuse
	# block. Grafana renders its own panels in iframes; DENY breaks them.
	# SAMEORIGIN gives the clickjacking protection without the breakage.
	#
	# The `>` is REQUIRED and is not cosmetic. Grafana sets its own
	# `X-Frame-Options: deny` upstream. Without the replacement operator Caddy
	# APPENDS, and the response carries the header twice with conflicting
	# values — which browsers treat as invalid and several ignore entirely,
	# silently dropping the very protection this line exists to provide.
	# Verified live on 2026-08-12: both headers were present. Audit finding F-15.
	header >X-Frame-Options "SAMEORIGIN"

	# ── Single catch-all. Identity is the control, not network position. ─────
	# There is exactly ONE handle here and it proxies. Do not add a
	# `handle { respond 403 }` alongside it: handle blocks are mutually
	# exclusive and evaluated in order, so a leftover deny handler would
	# black-hole Grafana entirely. Same trap as the Langfuse block above.
	handle {
		route {
			# Brute-force protection for the credential surface. Retained even
			# though the local login form is disabled: /login is also where the
			# SSO redirect and the OAuth callback (/login/azuread) land, and an
			# unthrottled OAuth callback is an open invitation to code-exchange
			# spam. 30/min per IP passes a normal browser round trip — several
			# calls — while sitting orders of magnitude below any attack.
			rate_limit {
				zone grafana_login {
					match {
						path /login*
					}
					key {remote_host}
					events 30
					window 1m
				}
			}
			reverse_proxy grafana:3000
		}
	}
}
