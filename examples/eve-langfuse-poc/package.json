{
  "name": "eve-langfuse-poc",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "verify": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-traces.ts",
    "provision:prices": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/provision-model-prices.ts",
    "prompts:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sync-prompts.ts --check",
    "prompts:sync": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sync-prompts.ts",
    "prompts:promote": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/promote-prompt.ts",
    "verify:prompt-resolver": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-prompt-resolver.ts",
    "datasets:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sync-datasets.ts --check",
    "datasets:sync": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sync-datasets.ts",
    "verify:prompt-link": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-prompt-link.ts",
    "experiment": "node --env-file-if-exists=.env.local --experimental-strip-types evals/experiment.ts",
    "verify:instructions": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-instruction-layers.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.43",
    "@ai-sdk/otel": "^1.0.60",
    "@langfuse/client": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@vercel/connect": "0.4.3",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.38",
    "eve": "^0.31.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "^7.0.38"
  },
  "engines": {
    "node": "24.x"
  }
}
