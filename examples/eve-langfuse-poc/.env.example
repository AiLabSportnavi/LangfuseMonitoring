# Copy to .env.local and fill in. .env.local is gitignored.

# ── Langfuse ────────────────────────────────────────────────────────────────
# Base URL only — the instrumentation appends /api/public/otel itself.
LANGFUSE_BASE_URL=https://sportnavi-langfuse.sportnavi.de

# Per-project key pair. Create them in the Langfuse UI under
# Project settings -> API keys, or provision with scripts/provision-project.sh.
# Never share one key pair across projects: a leaked key must be revocable in
# isolation, and per-project keys are what make ingestion attributable.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Separates this PoC's traces from real traffic in the Langfuse UI.
LANGFUSE_ENVIRONMENT=development

# ── Model provider ──────────────────────────────────────────────────────────
# agent/agent.ts uses "anthropic/claude-sonnet-5" through the Vercel AI Gateway.
# Create a key at https://vercel.com/[team]/~/ai/api-keys
AI_GATEWAY_API_KEY=
